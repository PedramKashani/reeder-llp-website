# Sanity (required for CMS reads + embedded Studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional
SANITY_API_VERSION=2025-01-01

# Scripts only — create in Sanity Manage with Editor permissions; never commit the real token
SANITY_WRITE_TOKEN=

# Contact form (unrelated to Sanity; documented for local dev)
FORMSPREE_ENDPOINT=
